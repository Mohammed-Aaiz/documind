# Docker Compose configuration template (repo root).
#
# Copy to `.env` (gitignored) and fill in the two REQUIRED secrets. Compose
# reads this file for ${...} interpolation. No real secret belongs in the repo.
#
#   cp .env.example .env

# --- Required ---------------------------------------------------------------
# PostgreSQL password used by the `db` service and the backend DATABASE_URL.
POSTGRES_PASSWORD=
# HS256 signing key. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# --- Optional (defaults shown) ---------------------------------------------
POSTGRES_USER=documind
POSTGRES_DB=documind
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_UPLOAD_SIZE_MB=50
OMP_NUM_THREADS=2

# --- Frontend (build-time, optional) ---------------------------------------
# The UI talks to the API same-origin through the nginx proxy, so this is left
# empty for the Compose stack. Set it only to point the bundle at another API.
# VITE_API_BASE_URL=
