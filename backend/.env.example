[TEMPLATE]
# Database
# Use the postgresql+asyncpg:// driver.  A libpq-style `?sslmode=require`
# query param is accepted for managed providers (Supabase, Render, ...) — it
# is translated to asyncpg's `ssl` argument automatically by
# storage/database.py.
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5432/documind

# Auth — REQUIRED in production.  Generate with: openssl rand -hex 32
# In development, you may set DOCUMIND_DEV=1 to skip the insecure-secret check.
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS — comma-separated allowlist of frontend origins.  Never use "*".
# Development: Vite dev (3000), Vite default (5173) and Vite preview (4173),
# via both loopback hostnames.  Production: set the deployed frontend origin,
# e.g. CORS_ORIGINS=https://documind.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Chunking strategy (Phase 3D)
# "legacy"        — original 1000-char / 200-char sliding window (production default)
# "structure-v2"  — structure-aware, token-budgeted chunker (candidate;
#                   only activate once the evaluation supports it)
# CHUNKER_VERSION=legacy

# Development mode — set to 1 to allow insecure JWT defaults (dev only!)
# DOCUMIND_DEV=1

# LLM (Phase 2)
# LLM_API_KEY=
# LLM_MODEL=

# Embeddings (Phase 2)
# EMBEDDING_MODEL=

# QA Model (Phase 5)
# Path to the trained DocuMind QA model directory
# This MUST point to a local directory with the trained model artifacts
# Default: ./models/documind-qa
# QA_MODEL_NAME=./models/documind-qa

# Generative answer path (2026-10-17, additive; local + offline only)
# Model id or a local directory. Weight provisioning is a one-time operator step;
# nothing is downloaded at request time once cached.
# DOCUMIND_GENERATOR_MODEL=google/flan-t5-base
# Kill switch for the additive `/api/generation/answer` route (default: enabled)
# DOCUMIND_GENERATOR_ENABLED=1

# Claim verifier (2026-10-17). "lexical" is the production default; "relations"
# selects the measured three-way claim verifier (SUPPORTED / CONTRADICTED /
# INSUFFICIENT_EVIDENCE). Evaluation: backend/architecture/
# DOCUMIND_EVIDENCE_VERIFICATION_2026-10-17.md — on the frozen benchmark it leaves EM
# and spurious answers unchanged, lowers token F1 by 0.027, and lowers the
# unsupported-claim rate from 0.198 to 0.165. Unknown values fall back to lexical.
# DOCUMIND_VERIFIER=lexical
