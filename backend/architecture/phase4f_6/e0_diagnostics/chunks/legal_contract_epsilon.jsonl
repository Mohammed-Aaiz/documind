{"chunk_id": "legal_contract_epsilon::c009", "document_id": "legal_contract_epsilon", "sequence": 9, "source_start": 1671, "source_end": 2158, "offset_resolution": "resolved", "heading_prefix_dropped": false, "text": "Intellectual Property\n\nThe Software and all associated intellectual property rights remain the exclusive property of Licensor. Licensee shall not reverse engineer, decompile, or disassemble the Software. Any derivative works created by Licensee using the Software shall be owned by Licensee, provided that Licensor retains all rights in the underlying Software. Licensee grants Licensor a non-exclusive, royalty-free license to use anonymized usage data for product improvement purposes.", "chunker_version": "chunk-v1-legacy-chars-1000-200", "chunk_char_len": 487, "source_document_hash": "b767a129ac560c3f800c6fe79f187c70ccbcaafc1dc1ce4d42179c708e3db567", "structure": {"section_ids": ["legal_contract_epsilon#s3"], "paragraph_ids": ["legal_contract_epsilon#s3#p1"], "table_ids": [], "row_ids": [], "cell_ids": [], "list_ids": [], "list_item_ids": []}}
