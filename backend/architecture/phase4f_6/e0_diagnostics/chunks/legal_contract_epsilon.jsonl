{"chunk_id": "legal_contract_epsilon::c006", "document_id": "legal_contract_epsilon", "sequence": 6, "source_start": 1104, "source_end": 1482, "offset_resolution": "resolved", "heading_prefix_dropped": false, "text": "Fees and Payment\n\nLicensee shall pay Licensor an annual license fee of $245,000 USD, payable in equal quarterly installments of $61,250 USD within 30 days of invoice date. Late payments shall incur interest at a rate of 1.5 percent per month. All fees are non-refundable except as expressly provided in Section 9. The annual fee shall increase by 5 percent at each renewal term.", "chunker_version": "chunk-v1-legacy-chars-1000-200", "chunk_char_len": 378, "source_document_hash": "b767a129ac560c3f800c6fe79f187c70ccbcaafc1dc1ce4d42179c708e3db567", "structure": {"section_ids": ["legal_contract_epsilon#s2"], "paragraph_ids": ["legal_contract_epsilon#s2#p1"], "table_ids": [], "row_ids": [], "cell_ids": [], "list_ids": [], "list_item_ids": []}}
