{"chunk_id": "legal_contract_epsilon::c003", "document_id": "legal_contract_epsilon", "sequence": 3, "source_start": 480, "source_end": 883, "offset_resolution": "resolved", "heading_prefix_dropped": false, "text": "License Grant\n\nSubject to the terms of this Agreement, Licensor hereby grants Licensee a non-exclusive, non-transferable, revocable license to install and use the Software on up to 50 concurrent devices for Licensee's internal business purposes only. The license term is 36 months commencing on the Effective Date and expiring on January 15, 2028, unless terminated earlier in accordance with Section 8.", "chunker_version": "chunk-v1-legacy-chars-1000-200", "chunk_char_len": 403, "source_document_hash": "b767a129ac560c3f800c6fe79f187c70ccbcaafc1dc1ce4d42179c708e3db567", "structure": {"section_ids": ["legal_contract_epsilon#s1"], "paragraph_ids": ["legal_contract_epsilon#s1#p1"], "table_ids": [], "row_ids": [], "cell_ids": [], "list_ids": [], "list_item_ids": []}}
{"chunk_id": "legal_contract_epsilon::c004", "document_id": "legal_contract_epsilon", "sequence": 4, "source_start": 885, "source_end": 1102, "offset_resolution": "resolved", "heading_prefix_dropped": true, "text": "License Grant\n\nPermitted Uses\nInternal data analysis and reporting\nIntegration with Licensee's proprietary platforms\nUse by Licensee's employees and authorized contractors\nTesting and quality assurance in non-production environments", "chunker_version": "chunk-v1-legacy-chars-1000-200", "chunk_char_len": 232, "source_document_hash": "b767a129ac560c3f800c6fe79f187c70ccbcaafc1dc1ce4d42179c708e3db567", "structure": {"section_ids": ["legal_contract_epsilon#s1"], "paragraph_ids": [], "table_ids": [], "row_ids": [], "cell_ids": [], "list_ids": ["legal_contract_epsilon#s1#l0"], "list_item_ids": ["legal_contract_epsilon#s1#l0#0", "legal_contract_epsilon#s1#l0#1", "legal_contract_epsilon#s1#l0#2", "legal_contract_epsilon#s1#l0#3"]}}
