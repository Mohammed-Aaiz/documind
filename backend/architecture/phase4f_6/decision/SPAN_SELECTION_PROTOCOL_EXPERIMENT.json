{
  "artifact": "SPAN_SELECTION_PROTOCOL_EXPERIMENT",
  "note": "Before/after experiment for upgrading the Phase 4F runner span-selection rule from the greedy argmax chain to joint-score selection. Every variant reads the same logits. Leaked population — not a generalization result.",
  "changed": "span-selection rule only",
  "held_fixed": [
    "benchmark",
    "checkpoints",
    "logits",
    "tokenization",
    "metric definitions",
    "answer-text reconstruction (Experiment 1)"
  ],
  "no_training": true,
  "recorded_protocol_audit": {
    "finding": "The recorded runner fleet is not uniform. 9 of the 10 runners call torch.argmax(start_logits) unmasked; only phase4f_5f/f2/threshold_experiment/run_threshold_experiment.py masks [CLS] (masked_start[0] = -inf).",
    "unmasked_runners": [
      "phase4f/experiments/run_experiment.py",
      "phase4f/experiments/evaluate.py",
      "phase4f/experiments/final_gpu_package/evaluation/evaluate.py",
      "phase4f/phase4f_5/run_experiment.py",
      "phase4f/phase4f_5/evaluation/evaluate.py",
      "phase4f/phase4f_5e/run_analysis.py",
      "phase4f/phase4f_5f/run_experiment.py",
      "phase4f/phase4f_5f/f2/run_f2.py",
      "phase4f/phase4f_5f/h1/run_h1.py"
    ],
    "cls_masked_runners": [
      "phase4f/phase4f_5f/f2/threshold_experiment/run_threshold_experiment.py"
    ]
  },
  "variants": {
    "S0_recorded_argmax_nomask50": "majority recorded runner protocol (9 of 10 runners): unmasked argmax(start), then argmax(end) in a 50-token window; answer text via reconstruct_answer incl. its decode fallback",
    "S0b_recorded_argmax_nomask50_strict": "identical selection; answer text via strict context mapping (shows what the decode fallback adds)",
    "S0c_recorded_argmax_clsmask50": "threshold_experiment protocol: [CLS]-masked argmax chain, window 50",
    "S4_recorded_argmax_nomask100": "majority recorded rule with the window widened to 100",
    "S1_joint_logit50": "joint max(s_logit + e_logit) via answer_span.select_joint_span, window 50",
    "S2_joint_logit100": "joint max(s_logit + e_logit) via answer_span.select_joint_span, window 100",
    "S3_production_nbest100_prob": "live production rule: 20x20 n-best, softmax_s * softmax_e, window 100"
  },
  "comparisons": [
    {
      "before": "S0_recorded_argmax_nomask50",
      "after": "S1_joint_logit50",
      "description": "majority recorded runner protocol (unmasked chain) -> joint selection, window 50"
    },
    {
      "before": "S0c_recorded_argmax_clsmask50",
      "after": "S1_joint_logit50",
      "description": "threshold_experiment protocol ([CLS]-masked chain) -> joint selection, window 50"
    },
    {
      "before": "S4_recorded_argmax_nomask100",
      "after": "S2_joint_logit100",
      "description": "unmasked chain at window 100 -> joint at window 100"
    }
  ],
  "limitations": [
    "Population is fully leaked (all 182 examples appear in training_data.jsonl / training_data_v3.jsonl); no generalization claim is possible.",
    "n = 140 answerable examples, so 1 example = 0.71pp; 1-2 example differences are noise and are reported as counts.",
    "Inference is CPU-only against the recorded checkpoints; no training and no weights changed.",
    "Joint selection maximises the MODEL'S own score, not accuracy, so the EM change is an empirical outcome — the EM gained/lost flips are reported alongside it.",
    "This is an offline protocol comparison. Applying it to the runners is a frozen-protocol change and is recorded as a decision, not performed silently."
  ],
