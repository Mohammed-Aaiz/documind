# DocuMind frontend image: build the Vite bundle, serve it with nginx.
#
# Build context: repository root (see compose.yaml and .dockerignore).
# The backend does not serve the SPA, so a static-serving runtime is required
# for a production-style stack. nginx also reverse-proxies /api to the backend,
# making the app same-origin (no CORS needed for the browser).
#
# No secrets are read at build time. The API is same-origin, so no
# VITE_API_BASE_URL is baked in.

FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json vite.config.ts tailwind.config.js postcss.config.js index.html ./
COPY src ./src
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
